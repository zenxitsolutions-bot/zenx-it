NODE_ENV=development
PORT=4001
MYSQL_URL=mysql://root:root@127.0.0.1:3307/zenx_admin

# Staff (ZenX employees, /admin/login) JWT realm — independent of the customer realm below.
ADMIN_JWT_ACCESS_SECRET=change-me
ADMIN_JWT_REFRESH_SECRET=change-me-too
ADMIN_JWT_ACCESS_TTL=15m
ADMIN_JWT_REFRESH_TTL=30d

# Customer (company contacts, /login) JWT realm — independent secrets so a leaked staff token can
# never be replayed as a customer token or vice versa.
CUSTOMER_JWT_ACCESS_SECRET=change-me
CUSTOMER_JWT_REFRESH_SECRET=change-me-too
CUSTOMER_JWT_ACCESS_TTL=15m
CUSTOMER_JWT_REFRESH_TTL=30d

# Comma-separated — this backend serves both the admin portal and the public marketing site's
# contact form, two different origins.
CLIENT_ORIGINS=http://localhost:5174,http://localhost:5173

RESEND_API_KEY=
EMAIL_FROM=ZenX Admin <onboarding@resend.dev>
# Staff inbox for new public contact-form enquiries. Optional — unset skips the email (the
# enquiry is still saved in the database).
ENQUIRY_NOTIFY_EMAIL=

# Direct MySQL URL for the Nourishly (wellness-app) database. Required to eagerly provision
# zenx-dietitian users and to sync company deactivation / dietitian assignment. Leave blank
# only if this deployment cannot reach that database.
# Must match zenx-wellness/server MYSQL_URL (local default below).
WELLNESS_MYSQL_URL=mysql://root:root@127.0.0.1:3306/nourishly

# Per-application handoff secret used to sign the SSO token issued to wellness-app. Must match
# that deployment's own ZENX_HANDOFF_SECRET exactly (see wellness-app/server/.env).
ZENX_DIETITIAN_URL=http://localhost:5175
ZENX_DIETITIAN_HANDOFF_SECRET=
