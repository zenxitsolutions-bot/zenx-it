# Copy to .env.local and fill in to connect the public contact form to the ZenX Admin backend
# (admin-server/, the same one admin/ talks to). Required for the form to persist enquiries.
# Bare host or host+/api both work (the client appends /api when missing).
#
# Development:  http://localhost:4001
# Staging:      https://admin-api-staging.example.com
# Production:   https://admin-api.example.com

VITE_ADMIN_API_URL=

# Where the navbar's "Admin Login" link points. Defaults to the local admin
# dev server (http://localhost:5174/admin/login) if unset. Set this once the
# admin portal is deployed, e.g. https://admin.zenxitsolutions.com/admin/login
VITE_ADMIN_URL=
