NODE_ENV=development
PORT=4000
MYSQL_URL=mysql://root:root@127.0.0.1:3306/nourishly
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CLIENT_ORIGIN=http://localhost:5173
# Optional extra CORS origins (comma-separated) — deploy previews / staging frontends.
# CLIENT_ORIGIN is always allowed and is the URL used in email links.
CLIENT_ORIGINS=
# Must match admin-server's ZENX_DIETITIAN_HANDOFF_SECRET exactly (see that repo's admin-server/.env).
ZENX_HANDOFF_SECRET=
# One-time use by db:migrate to backfill pre-multi-tenancy rows. Set to the company id printed by
# admin-server's seed.js (seedLegacyCompany) before running db:migrate; not needed afterward.
LEGACY_COMPANY_ID=
# --- SMTP (EMAIL_TRANSPORT=smtp) ---
# Port 587 = STARTTLS (most providers), port 465 = implicit TLS. SMTP_SECURE is derived from the
# port automatically; set it only to override that.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_SECURE=false
# Leave SMTP_USER blank for an internal relay that authenticates by IP instead of credentials.
# For Gmail/Google Workspace this must be an App Password, not the account password.
SMTP_USER=
SMTP_PASS=

# --- Resend (EMAIL_TRANSPORT=resend) ---
RESEND_API_KEY=

# Envelope sender for every transport. With SMTP this must be an address the server is allowed
# to send as, or the provider will reject the message.
EMAIL_FROM=ZenX Dietitian <onboarding@resend.dev>
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Notification engine (server/src/emails/). One of: smtp | resend | console. Unset means the
# console/file transport outside production; set it to "smtp" in development to send real email
# (requires SMTP_HOST above). NODE_ENV=test always forces "console" — anything else there is a
# startup error. In production it defaults to "smtp" (requires SMTP_HOST above).
EMAIL_TRANSPORT=smtp
EMAIL_QUEUE_POLL_INTERVAL_MS=5000
EMAIL_QUEUE_BATCH_SIZE=10
EMAIL_MAX_ATTEMPTS=5
# Consultation schedule rolling-window generator (server/src/services/consultationScheduleJob.js).
CONSULTATION_SCHEDULE_JOB_INTERVAL_MS=86400000

# --- Video calls -------------------------------------------------------------------------------
# Video calls. Which provider hosts a booked call's room: jitsi | google | none.
#   jitsi  (default) — no account, no OAuth, no credentials. Every scheduled call gets a room.
#   google           — only produces links for dietitians who have individually connected Google.
#   none             — no video rooms; calls are still booked and notified.
MEETING_PROVIDER=jitsi
# Public instance by default. SECURITY: on meet.jit.si a room has no access control — anyone with
# the URL can join, which is why room names are 128 bits of randomness (services/jitsiMeet.js).
# Point this at a self-hosted Jitsi to get lobbies, passwords and moderation.
JITSI_BASE_URL=https://meet.jit.si

# --- Google Calendar / Meet (optional) --------------------------------------------------------
# Optional in BOTH provider modes, but it does something different in each — for a dietitian who
# has connected their Google account:
#   MEETING_PROVIDER=jitsi   the call's Jitsi room is also written to their Google Calendar as a
#                            normal event (link in the location + description). No Google Meet room
#                            is created, so there is never a second, unused room to join by mistake.
#   MEETING_PROVIDER=google  Google creates the room itself and attaches it to the calendar event.
#
# Leave blank and nothing breaks: under jitsi every call still gets a working room, it just does
# not appear on the dietitian's Google Calendar (attendees still get the .ics attachment). Under
# google there is simply no link at all.
#
# Setup (Google Cloud Console, https://console.cloud.google.com):
#   1. Create a project, then APIs & Services > Library > enable "Google Calendar API".
#   2. APIs & Services > OAuth consent screen: External, add your Google account as a Test user
#      (an unverified app can only be used by listed test users).
#   3. Credentials > Create credentials > OAuth client ID > Web application.
#   4. Add this exact Authorised redirect URI:  http://localhost:4000/api/integrations/google/callback
#   5. Copy the client ID and secret below, restart the server, then use
#      "Connect Google" on the dietitian's Schedule calls screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback
