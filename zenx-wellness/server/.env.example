NODE_ENV=development
PORT=4000
MYSQL_URL=mysql://root:root@127.0.0.1:3306/nourishly
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CLIENT_ORIGIN=http://localhost:5173
# Optional extra CORS origins (comma-separated) — deploy previews / staging frontends.
# CLIENT_ORIGIN is always allowed and is the URL used in email links.
CLIENT_ORIGINS=
# Must match admin-server's ZENX_DIETITIAN_HANDOFF_SECRET exactly (see that repo's admin-server/.env).
ZENX_HANDOFF_SECRET=
# One-time use by db:migrate to backfill pre-multi-tenancy rows. Set to the company id printed by
# admin-server's seed.js (seedLegacyCompany) before running db:migrate; not needed afterward.
LEGACY_COMPANY_ID=
RESEND_API_KEY=
EMAIL_FROM=Nourishly <onboarding@resend.dev>
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Notification engine (server/src/emails/). Leave EMAIL_TRANSPORT unset outside production — it's
# forced to the console/file transport there regardless, and setting it to anything but "console"
# is a startup error. In production it defaults to "resend" (requires RESEND_API_KEY above).
EMAIL_TRANSPORT=
EMAIL_QUEUE_POLL_INTERVAL_MS=5000
EMAIL_QUEUE_BATCH_SIZE=10
EMAIL_MAX_ATTEMPTS=5
# Consultation schedule rolling-window generator (server/src/services/consultationScheduleJob.js).
CONSULTATION_SCHEDULE_JOB_INTERVAL_MS=86400000

# --- Google Calendar / Meet (optional) --------------------------------------------------------
# When set, every call booked by a dietitian who has connected their Google account gets its own
# Google Meet room, attached to the calendar invite and shown as a "Join" button in the portal.
# Leave blank and the feature is simply inert: calls are still booked, just without a link.
#
# Setup (Google Cloud Console, https://console.cloud.google.com):
#   1. Create a project, then APIs & Services > Library > enable "Google Calendar API".
#   2. APIs & Services > OAuth consent screen: External, add your Google account as a Test user
#      (an unverified app can only be used by listed test users).
#   3. Credentials > Create credentials > OAuth client ID > Web application.
#   4. Add this exact Authorised redirect URI:  http://localhost:4000/api/integrations/google/callback
#   5. Copy the client ID and secret below, restart the server, then use
#      "Connect Google" on the dietitian's Schedule calls screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback
