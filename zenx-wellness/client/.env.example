# Nourishly API base URL. Include /api or omit it — the client appends /api when missing.
# Development:  http://localhost:4000/api
# Staging:      https://nourishly-api-staging.example.com/api
# Production:   https://nourishly-api.onrender.com/api
# Never leave this unset in a production/staging build — the client will not guess a remote host.
VITE_API_URL=http://localhost:4000/api
