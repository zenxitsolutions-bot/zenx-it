generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum SystemRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  MANAGER
  DIETITIAN
  TRAINER
  RECEPTIONIST
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  LOST
  NOT_INTERESTED
  FUTURE_FOLLOW_UP
}

enum FollowUpStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum DietType {
  VEGETARIAN
  NON_VEGETARIAN
}

enum CallingFrequency {
  DAILY
  EVERY_2_DAYS
  EVERY_3_DAYS
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

enum MealType {
  BREAKFAST
  LUNCH
  SNACK
  DINNER
  CUSTOM
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum WorkoutPlanType {
  DAILY
  WEEKLY
}

enum CustomerEnquiryStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  LOST
  NOT_INTERESTED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                 String     @id @default(uuid())
  companyId          String?
  firstName          String     @db.VarChar(100)
  lastName           String     @db.VarChar(100)
  email              String     @db.VarChar(191)
  username           String?    @unique @db.VarChar(100)
  phone              String?    @db.VarChar(30)
  passwordHash       String     @db.VarChar(255)
  role               SystemRole @default(CLIENT)
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  // IANA id; falls back to the company timezone when unset.
  timezone           String?    @db.VarChar(64)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  company       Company?       @relation(fields: [companyId], references: [id])
  platformAdmin PlatformAdmin?

  roles                UserRole[]
  dietitianClients     Client[]                 @relation("ClientDietitian")
  trainerClients       Client[]                 @relation("ClientTrainer")
  assignedEnquiries    CustomerEnquiry[]        @relation("CustomerEnquiryAssignee")
  enquiryComments      CustomerEnquiryComment[]
  enquiryFollowUps     EnquiryFollowUp[]

  dietitianProfile     Dietitian?
  trainerProfile       Trainer?
  clientRecord         Client?                     @relation("ClientPortalUser")
  availability         Availability[]
  availabilityBlocks   AvailabilityBlock[]
  dietitianAssignments ClientDietitianAssignment[] @relation("AssignmentDietitian")
  trainerAssignments   ClientTrainerAssignment[]   @relation("AssignmentTrainer")
  createdRecipes       Recipe[]
  createdDietPlans     DietPlan[]
  createdExercises     Exercise[]
  createdWorkoutPlans  WorkoutPlan[]
  passwordResets       PasswordResetToken[]

  // Scoped per tenant so one person can hold accounts at several companies.
  // MySQL does not collide NULL companyId rows, so platform-admin email
  // uniqueness is enforced in the service layer instead.
  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

/// One-shot, hashed password-reset tickets. The raw token only ever exists in
/// the email we send, so a leaked table row cannot be replayed.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  /// sha256 of the token that went out in the email.
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// ZenX employees. Authentication stays on `users`; this is the platform-side
/// directory that enquiries, follow-ups and comments are attributed to.
model PlatformAdmin {
  id          String   @id @default(uuid())
  userId      String   @unique
  designation String?  @db.VarChar(120)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedEnquiries PlatformEnquiry[]        @relation("EnquiryAssignee")
  followUps         PlatformFollowUp[]
  comments          PlatformEnquiryComment[]

  @@map("platform_admins")
}

// ---------------------------------------------------------------------------
// Companies & tenancy
// ---------------------------------------------------------------------------

model Company {
  id            String        @id @default(uuid())
  name          String        @db.VarChar(150)
  slug          String        @unique @db.VarChar(100)
  logoUrl       String?       @db.VarChar(500)
  email         String        @db.VarChar(191)
  phone         String?       @db.VarChar(30)
  address       String?       @db.Text
  country       String        @db.VarChar(100)
  // IANA id — every schedule in this tenant is rendered against it.
  timezone      String        @db.VarChar(64)
  accountStatus CompanyStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  domains       CompanyDomain[]
  subscriptions Subscription[]
  users         User[]
  sourceEnquiry PlatformEnquiry?
  roles         Role[]
  clients       Client[]
  enquiries     CustomerEnquiry[]
  dietitians    Dietitian[]
  trainers      Trainer[]
  recipes       Recipe[]
  dietPlans     DietPlan[]
  exercises     Exercise[]
  workoutPlans  WorkoutPlan[]

  @@index([accountStatus])
  @@map("companies")
}

model CompanyDomain {
  id        String   @id @default(uuid())
  companyId String
  subdomain String   @unique @db.VarChar(100)
  isPrimary Boolean  @default(true)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_domains")
}

// ---------------------------------------------------------------------------
// Subscriptions
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  /// Free-form feature map, e.g. { "maxClients": 500, "workoutPlans": true }
  features    Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id        String             @id @default(uuid())
  companyId String
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([companyId])
  @@index([planId])
  @@index([status, endDate])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Platform enquiries
// ---------------------------------------------------------------------------

model PlatformEnquiry {
  id                 String        @id @default(uuid())
  companyName        String        @db.VarChar(150)
  contactName        String        @db.VarChar(150)
  email              String        @db.VarChar(191)
  phone              String?       @db.VarChar(30)
  source             String?       @db.VarChar(100)
  notes              String?       @db.Text
  status             EnquiryStatus @default(NEW)
  assignedToId       String?
  convertedCompanyId String?       @unique
  convertedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  assignedTo       PlatformAdmin?           @relation("EnquiryAssignee", fields: [assignedToId], references: [id])
  convertedCompany Company?                 @relation(fields: [convertedCompanyId], references: [id])
  followUps        PlatformFollowUp[]
  comments         PlatformEnquiryComment[]

  @@index([status])
  @@index([assignedToId])
  @@map("platform_enquiries")
}

model PlatformFollowUp {
  id        String         @id @default(uuid())
  enquiryId String
  /// Stored as a UTC instant; `timezone` records the IANA zone it was booked in.
  dueAt     DateTime
  timezone  String         @db.VarChar(64)
  remindAt  DateTime?
  reminderSentAt DateTime?
  status    FollowUpStatus @default(SCHEDULED)
  outcome   String?        @db.Text
  notes     String?        @db.Text
  completedAt DateTime?
  createdById String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  enquiry   PlatformEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  createdBy PlatformAdmin   @relation(fields: [createdById], references: [id])

  @@index([enquiryId])
  @@index([status, dueAt])
  @@index([remindAt])
  @@map("platform_followups")
}

model PlatformEnquiryComment {
  id        String   @id @default(uuid())
  enquiryId String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiry PlatformEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  author  PlatformAdmin   @relation(fields: [authorId], references: [id])

  @@index([enquiryId])
  @@map("platform_enquiry_comments")
}

// ---------------------------------------------------------------------------
// RBAC — roles are per company, the permission catalog is global
// ---------------------------------------------------------------------------

/// A capability, e.g. `clients.view`. Seeded once and shared by every tenant.
model Permission {
  id       String @id @default(uuid())
  key      String @unique @db.VarChar(100)
  category String @db.VarChar(50)
  action   String @db.VarChar(50)
  label    String @db.VarChar(150)

  roles RolePermission[]

  @@index([category])
  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid())
  companyId   String
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  /// Seeded roles a company cannot delete; the admin role also cannot have its
  /// permissions stripped, so a tenant can never lock itself out.
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

model Client {
  id        String       @id @default(uuid())
  companyId String
  status    ClientStatus @default(ACTIVE)

  // Basic
  firstName String    @db.VarChar(100)
  lastName  String    @db.VarChar(100)
  email     String?   @db.VarChar(191)
  phone     String?   @db.VarChar(30)
  dob       DateTime? @db.Date
  gender    Gender?
  address   String?   @db.Text
  country   String?   @db.VarChar(100)
  /// IANA id for the client's own locale.
  timezone  String?   @db.VarChar(64)

  // Diet preferences
  dietType           DietType?
  /// String arrays, e.g. ["high protein", "low sodium"]
  foodPreferences    Json?
  foodAllergies      Json?
  mealsPerDay        Int?
  /// e.g. { "breakfast": "08:00", "lunch": "13:00" } in the client's timezone
  preferredMealTimes Json?

  // Measurements
  heightCm       Float?
  weightKg       Float?
  /// Derived from height and weight whenever both are present.
  bmi            Float?
  targetWeightKg Float?
  waistCm        Float?
  hipCm          Float?
  /// Company-configurable extras, e.g. { "bodyFatPct": 22.4 }
  extraMeasurements Json?

  // Calling preferences — rules only; 2D's scheduler consumes them.
  callingFrequency       CallingFrequency?
  everyXDays             Int?
  /// ISO weekday numbers, 1 = Monday … 7 = Sunday
  specificDaysOfWeek     Json?
  specificDayOfMonth     Int?
  preferredCallingDays   Json?
  /// Wall-clock "HH:mm" in callingTimezone — never a UTC instant, so the slot
  /// stays put across DST.
  preferredCallingTime   String?  @db.VarChar(5)
  callingTimezone        String?  @db.VarChar(64)
  callDurationMinutes    Int?
  assignedDietitianId    String?
  assignedTrainerId      String?
  callStartDate          DateTime? @db.Date
  callEndDate            DateTime? @db.Date
  numberOfScheduledCalls Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Optional portal login for the client themselves.
  userId String? @unique

  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User?            @relation("ClientPortalUser", fields: [userId], references: [id])
  assignedDietitian User?            @relation("ClientDietitian", fields: [assignedDietitianId], references: [id])
  assignedTrainer   User?            @relation("ClientTrainer", fields: [assignedTrainerId], references: [id])
  sourceEnquiry     CustomerEnquiry?

  dietitianAssignments ClientDietitianAssignment[]
  trainerAssignments   ClientTrainerAssignment[]
  dietPlans            DietPlanAssignment[]
  workoutPlans         WorkoutPlanAssignment[]

  @@index([companyId, status])
  @@index([companyId, assignedDietitianId])
  @@index([companyId, assignedTrainerId])
  @@map("clients")
}

// ---------------------------------------------------------------------------
// Customer enquiries
// ---------------------------------------------------------------------------

model CustomerEnquiry {
  id                String                @id @default(uuid())
  companyId         String
  firstName         String                @db.VarChar(100)
  lastName          String                @db.VarChar(100)
  email             String?               @db.VarChar(191)
  phone             String?               @db.VarChar(30)
  source            String?               @db.VarChar(100)
  notes             String?               @db.Text
  status            CustomerEnquiryStatus @default(NEW)
  assignedToId      String?
  convertedClientId String?               @unique
  convertedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  company         Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo      User?                    @relation("CustomerEnquiryAssignee", fields: [assignedToId], references: [id])
  convertedClient Client?                  @relation(fields: [convertedClientId], references: [id])
  followUps       EnquiryFollowUp[]
  comments        CustomerEnquiryComment[]

  @@index([companyId, status])
  @@index([companyId, assignedToId])
  @@map("customer_enquiries")
}

model EnquiryFollowUp {
  id        String    @id @default(uuid())
  /// Denormalised from the enquiry so every tenant filter is a direct predicate.
  companyId String
  enquiryId String
  /// UTC instant; `timezone` records the IANA zone it was booked in.
  dueAt     DateTime
  timezone  String    @db.VarChar(64)
  remindAt  DateTime?
  reminderSentAt DateTime?
  status    FollowUpStatus @default(SCHEDULED)
  outcome   String?   @db.Text
  notes     String?   @db.Text
  completedAt DateTime?
  createdById String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  enquiry   CustomerEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  createdBy User            @relation(fields: [createdById], references: [id])

  @@index([companyId, status, dueAt])
  @@index([enquiryId])
  @@index([remindAt])
  @@map("enquiry_followups")
}

model CustomerEnquiryComment {
  id        String   @id @default(uuid())
  companyId String
  enquiryId String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiry CustomerEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  author  User            @relation(fields: [authorId], references: [id])

  @@index([companyId, enquiryId])
  @@map("customer_enquiry_comments")
}

// ---------------------------------------------------------------------------
// Staff profiles
//
// Authentication and identity stay on `users`; these hold the role-specific
// profile fields, exactly as platform_admins does for ZenX staff. Name, email,
// phone, timezone and status all live on the linked user, so there is one
// source of truth for each.
// ---------------------------------------------------------------------------

model Dietitian {
  id             String   @id @default(uuid())
  companyId      String
  userId         String   @unique
  specialization String?  @db.VarChar(150)
  address        String?  @db.Text
  bio            String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("dietitians")
}

model Trainer {
  id             String   @id @default(uuid())
  companyId      String
  userId         String   @unique
  specialization String?  @db.VarChar(150)
  address        String?  @db.Text
  bio            String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("trainers")
}

/// Assignments point at the staff user id, so scoping a query needs no profile
/// join. `isPrimary` mirrors Client.assignedDietitianId.
model ClientDietitianAssignment {
  id              String   @id @default(uuid())
  companyId       String
  clientId        String
  dietitianUserId String
  isPrimary       Boolean  @default(false)
  assignedById    String?
  assignedAt      DateTime @default(now())

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dietitian User   @relation("AssignmentDietitian", fields: [dietitianUserId], references: [id], onDelete: Cascade)

  @@unique([clientId, dietitianUserId])
  @@index([companyId, dietitianUserId])
  @@map("client_dietitian_assignments")
}

model ClientTrainerAssignment {
  id            String   @id @default(uuid())
  companyId     String
  clientId      String
  trainerUserId String
  isPrimary     Boolean  @default(false)
  assignedById  String?
  assignedAt    DateTime @default(now())

  client  Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainer User   @relation("AssignmentTrainer", fields: [trainerUserId], references: [id], onDelete: Cascade)

  @@unique([clientId, trainerUserId])
  @@index([companyId, trainerUserId])
  @@map("client_trainer_assignments")
}

// ---------------------------------------------------------------------------
// Availability
// ---------------------------------------------------------------------------

/// One recurring weekly window. A staff member may hold several per weekday
/// (e.g. Monday 09:00-12:00 and 14:00-18:00).
model Availability {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  /// ISO weekday, 1 = Monday through 7 = Sunday
  dayOfWeek Int      @db.TinyInt
  /// Wall-clock "HH:mm" in `timezone`, never a UTC instant, so a 09:00 start
  /// stays 09:00 after a DST transition.
  startTime String   @db.VarChar(5)
  endTime   String   @db.VarChar(5)
  timezone  String   @db.VarChar(64)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, dayOfWeek])
  @@map("availability")
}

/// One-off unavailability: leave, vacation, a blocked afternoon.
model AvailabilityBlock {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  /// When false, startTime/endTime bound the blocked part of each day.
  isFullDay Boolean  @default(true)
  startTime String?  @db.VarChar(5)
  endTime   String?  @db.VarChar(5)
  timezone  String   @db.VarChar(64)
  reason    String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, startDate, endDate])
  @@map("availability_blocks")
}

// ---------------------------------------------------------------------------
// Recipes and diet plans
// ---------------------------------------------------------------------------

model Recipe {
  id               String   @id @default(uuid())
  companyId        String
  name             String   @db.VarChar(200)
  description      String?  @db.Text
  /// [{ name, quantity, unit }, ...]
  ingredients      Json?
  prepInstructions String?  @db.Text
  mealType         MealType @default(CUSTOM)
  calories         Float?
  protein          Float?
  carbs            Float?
  fat              Float?
  prepTimeMinutes  Int?
  servingSize      String?  @db.VarChar(100)
  mediaUrl         String?  @db.VarChar(500)
  createdById      String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?          @relation(fields: [createdById], references: [id])
  planItems DietPlanItem[]

  @@index([companyId, mealType])
  @@index([companyId, isActive])
  @@map("recipes")
}

model DietPlan {
  id          String   @id @default(uuid())
  companyId   String
  name        String   @db.VarChar(200)
  description String?  @db.Text
  notes       String?  @db.Text
  createdById String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User?                @relation(fields: [createdById], references: [id])
  items       DietPlanItem[]
  assignments DietPlanAssignment[]

  @@index([companyId, isActive])
  @@map("diet_plans")
}

/// One meal slot on one weekday. Either `recipeId` or the inline custom fields
/// are set, never both and never neither.
model DietPlanItem {
  id                 String   @id @default(uuid())
  companyId          String
  dietPlanId         String
  /// ISO weekday, 1 = Monday through 7 = Sunday
  dayOfWeek          Int      @db.TinyInt
  mealType           MealType
  sortOrder          Int      @default(0)
  recipeId           String?
  customTitle        String?  @db.VarChar(200)
  customInstructions String?  @db.Text
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  dietPlan DietPlan @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  recipe   Recipe?  @relation(fields: [recipeId], references: [id])

  @@index([companyId, dietPlanId])
  @@index([dietPlanId, dayOfWeek, mealType])
  @@map("diet_plan_items")
}

model DietPlanAssignment {
  id           String    @id @default(uuid())
  companyId    String
  dietPlanId   String
  clientId     String
  assignedById String?
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  isActive     Boolean   @default(true)
  assignedAt   DateTime  @default(now())

  dietPlan DietPlan @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([dietPlanId, clientId])
  @@index([companyId, clientId])
  @@map("diet_plan_assignments")
}

// ---------------------------------------------------------------------------
// Exercises and workout plans
// ---------------------------------------------------------------------------

model Exercise {
  id                 String      @id @default(uuid())
  companyId          String
  name               String      @db.VarChar(200)
  description        String?     @db.Text
  instructions       String?     @db.Text
  targetMuscleGroup  String?     @db.VarChar(100)
  equipment          String?     @db.VarChar(150)
  difficulty         Difficulty?
  mediaUrl           String?     @db.VarChar(500)
  exerciseType       String?     @db.VarChar(100)
  /// Defaults a plan item may override.
  durationSeconds    Int?
  defaultSets        Int?
  defaultRepetitions Int?
  restTimeSeconds    Int?
  createdById        String?
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?             @relation(fields: [createdById], references: [id])
  planItems WorkoutPlanItem[]

  @@index([companyId, isActive])
  @@index([companyId, targetMuscleGroup])
  @@map("exercises")
}

model WorkoutPlan {
  id          String          @id @default(uuid())
  companyId   String
  name        String          @db.VarChar(200)
  description String?         @db.Text
  planType    WorkoutPlanType @default(WEEKLY)
  notes       String?         @db.Text
  createdById String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User?                   @relation(fields: [createdById], references: [id])
  items       WorkoutPlanItem[]
  assignments WorkoutPlanAssignment[]

  @@index([companyId, isActive])
  @@map("workout_plans")
}

model WorkoutPlanItem {
  id              String   @id @default(uuid())
  companyId       String
  workoutPlanId   String
  /// ISO weekday for a weekly plan; null on a daily plan.
  dayOfWeek       Int?     @db.TinyInt
  sortOrder       Int      @default(0)
  exerciseId      String
  sets            Int?
  repetitions     Int?
  durationSeconds Int?
  restTimeSeconds Int?
  instructions    String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workoutPlan WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercise    Exercise    @relation(fields: [exerciseId], references: [id])

  @@index([companyId, workoutPlanId])
  @@index([workoutPlanId, dayOfWeek])
  @@map("workout_plan_items")
}

model WorkoutPlanAssignment {
  id            String    @id @default(uuid())
  companyId     String
  workoutPlanId String
  clientId      String
  assignedById  String?
  startDate     DateTime? @db.Date
  endDate       DateTime? @db.Date
  isActive      Boolean   @default(true)
  assignedAt    DateTime  @default(now())

  workoutPlan WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([workoutPlanId, clientId])
  @@index([companyId, clientId])
  @@map("workout_plan_assignments")
}
