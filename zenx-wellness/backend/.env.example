# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/zenx_wellness"

# Auth
JWT_SECRET="replace_with_secure_secret"
JWT_EXPIRES_IN="1d"

# CORS
# One origin, or several separated by commas
CLIENT_URL="http://localhost:5173"

# Seed (super admin bootstrap — no public registration)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=

# Tenancy
# Customer tenants are resolved as <subdomain>.<APP_DOMAIN>
APP_DOMAIN="dietitian.zenxitsolutions.com"
# Subdomains that address the ZenX platform itself, never a customer tenant
PLATFORM_HOSTS="admin,platform,www"

# Email (Resend)
RESEND_API_KEY=""
MAIL_FROM="ZenX Wellness <onboarding@resend.dev>"
MAIL_REPLY_TO=
PASSWORD_RESET_TTL_MINUTES="60"
