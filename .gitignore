.env

# Secret-bearing files a bare ".env" rule does NOT match. Every one of these holds real
# credentials (MySQL passwords, SMTP keys, JWT secrets) — the *.example files are the only
# env files that belong in the repo.
.env.*
!.env.example
*.bak
*.bak.*

